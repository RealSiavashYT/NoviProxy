{
  "manifest_version": 3,
  "name": "noviproxy",
  "version": "1.0.0",
  "description": "اتصال سریع به پروکسی SOCKS5 با یک کلیک",
  "permissions": ["proxy", "storage"],
  "host_permissions": ["https://api.ipify.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "noviproxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
